# Point the computer-use demo at a local/LAN Ollama box instead of the
# first-party Anthropic API. Copy to .env and edit the host.
#
# Ollama serves the native Anthropic Messages API at {BASE_URL}/v1/messages.
ANTHROPIC_BASE_URL=http://<your-ollama-host>:11434

# Any non-empty string; Ollama ignores it but the SDK requires a key.
ANTHROPIC_API_KEY=ollama

# Allow the Ollama-hosted models as --model choices (run with --thinking off
# for models that don't support output_config.effort).
CU_EXTRA_MODELS=kimi-k2.6:cloud,minimax-m3:cloud,qwen3.6:35b

# Ollama's /v1/messages drops images nested in tool_result blocks, which blinds
# the agent. Relay screenshots as top-level image blocks so the model sees them.
CU_RELAY_IMAGES_TOP_LEVEL=true
